# Copy this file to .env and fill in your own values.

# Required: your OpenAI API key for the LLM-powered CrewAI agents.
#OPENAI_API_KEY=sk-your-key-here



# Optional: override the default model used by all agents.
OPENAI_MODEL_NAME=gpt-4o-mini

# Optional: base URL the Streamlit UI uses to reach the FastAPI backend.
AGENTCARE_API_URL=http://127.0.0.1:8000
